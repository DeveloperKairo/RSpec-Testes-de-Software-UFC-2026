<div class="auth-container">
  <h1 class="auth-title">Bem-vindo de volta</h1>
  <p class="auth-subtitle">Entre na sua conta</p>

  <%= form_with(url: login_path) do |f| %>
    <div class="form-group">
      <%= f.label :email, "Endereço de email", class: "form-label" %>
      <%= f.email_field :email, class: "form-control", placeholder: "you@example.com", required: true %>
    </div>
    
    <div class="form-group">
      <%= f.label :password, "Senha", class: "form-label" %>
      <%= f.password_field :password, class: "form-control", placeholder: "••••••••", required: true %>
    </div>

    <%= f.submit "Entrar", class: "btn btn-primary", style: "width: 100%; margin-top: 0.5rem;" %>
  <% end %>

  <div style="text-align: center; margin-top: 2rem; font-size: 0.875rem;">
    <span style="color: var(--text-secondary);">Não tem uma conta?</span>
    <%= link_to "Cadastre-se", cadastro_path, style: "font-weight: 500; color: var(--text-primary);" %>
  </div>
</div>
