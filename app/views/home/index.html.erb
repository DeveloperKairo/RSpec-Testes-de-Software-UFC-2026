<div class="auth-container" style="text-align: center; border: none; box-shadow: none; max-width: 600px; background: transparent;">
  <h1 style="font-size: 3.5rem; margin-bottom: 1rem; line-height: 1.1; letter-spacing: -0.05em;">Gerenciador de Tarefas</h1>
  <p style="font-size: 1.125rem; color: var(--text-secondary); margin-bottom: 3rem;">
    A ferramenta moderna para gerenciar projetos, organizar ideias e executar tarefas de forma eficiente e limpa.
  </p>
  
  <div style="display: flex; gap: 1rem; justify-content: center;">
    <%= link_to "Começar agora", cadastro_path, class: "btn btn-primary", style: "padding: 0.75rem 1.5rem; font-size: 1rem;" %>
    <%= link_to "Fazer login", login_path, class: "btn btn-secondary", style: "padding: 0.75rem 1.5rem; font-size: 1rem;" %>
  </div>
</div>
