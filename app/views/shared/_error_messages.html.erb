<% if object.errors.any? %>
  <div class="flash alert" style="margin-bottom: 1.5rem; position: static; animation: none;">
    <ul style="margin-left: 1.5rem; margin-bottom: 0;">
      <% object.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
  </div>
<% end %>
