<div style="margin-bottom: 2rem;">
  <%= link_to "← Voltar ao Projeto", @project, style: "font-size: 0.875rem; color: var(--text-secondary); font-weight: 500;" %>
</div>
<div style="max-width: 500px;">
  <h1 style="font-size: 1.5rem; margin-bottom: 0.5rem;">Nova tarefa</h1>
  <p style="color: var(--text-secondary); margin-bottom: 2rem;">Adicionar nova tarefa a <strong><%= @project.name %></strong>.</p>
  <%= render 'form', project: @project, task: @task %>
</div>
